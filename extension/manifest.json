{
  "manifest_version": 3,
  "name": "attendance: digital.oxu.uz sinxronlash",
  "version": "2.0.0",
  "description": "digital.oxu.uz ga o'zingiz kirasiz (login, parol, robot tekshiruvi). Kirganingizdan keyin sessiya attendance ilovasiga o'zi uzatiladi va sinxronlanadi.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://digital.oxu.uz/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://davomat.lidersement.uz/*"
  ],
  "action": {
    "default_title": "attendance: digital.oxu.uz sinxronlash"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://davomat.lidersement.uz/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://digital.oxu.uz/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
